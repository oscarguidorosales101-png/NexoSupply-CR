# ==========================================
# NexoSupply CR - Backend Environment Variables
# ==========================================

# Puerto de servicio API
PORT=4000
NODE_ENV=development

# Conexión a Base de Datos MySQL 8
# Formato: mysql://USUARIO:CONTRASENA@HOST:PUERTO/NOMBRE_BD
DATABASE_URL="mysql://root@127.0.0.1:3306/nexosupply_cr"

# Seguridad y Autenticación JWT
JWT_SECRET="ejemplo_jwt_secret_desarrollo_nexosupply_cambiar_en_produccion"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_SECRET="ejemplo_refresh_secret_desarrollo_nexosupply"
JWT_REFRESH_EXPIRES_IN="7d"

# Configuración CORS
CORS_ORIGIN="http://localhost:5173"

# Google Cloud & Google Drive API v3
# Ruta al archivo JSON de cuenta de servicio de Google Cloud
GOOGLE_APPLICATION_CREDENTIALS="../nexosupply-cr-209e6cfebcda (1).json"
# ID de la carpeta raíz compartida en Google Drive (NexoSupply-Knowledge)
GOOGLE_DRIVE_ROOT_FOLDER_ID=""
# Habilitar sincronización periódica en segundo plano
GOOGLE_DRIVE_SYNC_ENABLED=true
# Intervalo de sincronización incremental en minutos
GOOGLE_DRIVE_SYNC_INTERVAL=5

# Base Vectorial (Qdrant)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# Proveedor de Embeddings (local, openai, cohere, huggingface)
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL="local-semantic-384"

# Parámetros de Fragmentación RAG
RAG_CHUNK_SIZE=750
RAG_CHUNK_OVERLAP=100

# Chatbot Empresarial (Desactivado hasta autorización explícita del propietario)
AI_API_KEY=""
DEEPSEEK_API_KEY=""

# Notificaciones y Correo SMTP
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@nexosupply.cr"
